# Copy to .env on the production server only, or set these in the hosting panel.
# Replace every CHANGE_ME value and example.com address before use.
APP_NAME="SUMMIT 2026"
APP_ENV=production
# Fresh installation: run php artisan key:generate --force once.
# Existing installation/database: keep its original APP_KEY.
APP_KEY=
APP_DEBUG=false
APP_URL=https://summit.example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CHANGE_ME_DATABASE
DB_USERNAME=CHANGE_ME_DATABASE_USER
DB_PASSWORD="CHANGE_ME_DATABASE_PASSWORD"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=300
BROADCAST_CONNECTION=log

# Use your mail provider's settings. smtp + port 587 supports STARTTLS.
# For implicit TLS, use MAIL_SCHEME=smtps and the provider's port (usually 465).
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_SMTP_USERNAME
MAIL_PASSWORD="CHANGE_ME_SMTP_PASSWORD"
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
